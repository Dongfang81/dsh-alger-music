{
  "name": "dsh-alger-music",
  "version": "0.1.11",
  "description": "DSH 本地音乐控制插件：驱动开源播放器 AlgerMusicPlayer 播放网易云音乐，附带浏览器浮动播放小窗。走 App 自带的本地服务——30488 网易云音乐 API（搜索/详情/歌词）+ 31888 远程控制（播放/暂停/切歌/音量）+ CDP（点歌直达播放）。零运行时依赖。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/alger.js": "./lib/alger.js",
    "./lib/cdp.js": "./lib/cdp.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "test"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/alger.js && node --check lib/cdp.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "music",
    "alger",
    "netease",
    "网易云音乐",
    "floating-player"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
